rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function chatPayloadOk() {
      return request.resource.data.keys().hasAll(['uid','name','text','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 120;
    }
    function scoreField(field) {
      return !(field in request.resource.data)
        || (resource == null && request.resource.data[field] == 0)
        || (resource != null && !(field in resource.data) && request.resource.data[field] == 0)
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }
    function scoreFieldsUnchanged() {
      return scoreField('caroWins') && scoreField('caroLosses') && scoreField('caroDraws')
        && scoreField('caroPoints') && scoreField('pvpPoints') && scoreField('wins')
        && scoreField('losses') && scoreField('draws')
        && scoreField('bestPvpScore') && scoreField('bestScore');
    }

    /* BXH kỳ (ngày/tuần/tháng) — client chỉ đọc, ghi qua Cloud Function */
    match /periodScores/{periodId} {
      allow read: if signedIn();
      match /entries/{uid} {
        allow read: if signedIn();
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }
    }

    /* ID công khai CBxxxxxx → uid (tìm bạn theo ID) */
    match /playerIds/{publicId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && scoreFieldsUnchanged();
      allow delete: if isOwner(uid);

      match /friends/{fid} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(uid);
      }

      match /lbClaims/{claimId} {
        allow read, create, update: if isOwner(uid);
      }

      /* Danh sách người dùng đã chặn — chỉ chủ tài khoản đọc/ghi được */
      match /blocked/{blockedUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasAll(['blockedAt']);
        allow delete: if isOwner(uid);
      }

      /* Lời mời kết bạn — người nhận sở hữu doc */
      match /friendRequests/{fromUid} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.status in ['pending', 'accepted_notice'];
      }

      /* Lời mời vào phòng — người nhận sở hữu doc */
      match /invites/{inviteId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.roomId is string
          && request.resource.data.code is string
          && request.resource.data.gameType in ['caro', 'versus'];
      }
    }

    match /matchQueue/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      // Người tạo phải là host hoặc guest của chính room đó (chặn ghép mạo danh),
      // guestId không được trùng hostId (chặn tự đấu với chính mình để x2 điểm),
      // và không được tạo phòng đã ở trạng thái 'finished' sẵn hoặc có winnerId
      // (chặn bỏ qua trận đấu, tạo thẳng phòng "đã thắng" để applyMatchResult cộng điểm khống).
      allow create: if signedIn()
        && request.resource.data.hostId is string
        && (
          request.auth.uid == request.resource.data.hostId ||
          (('guestId' in request.resource.data) && request.auth.uid == request.resource.data.guestId)
        )
        && (!('guestId' in request.resource.data)
            || request.resource.data.guestId == null
            || request.resource.data.guestId != request.resource.data.hostId)
        && (!('status' in request.resource.data) || request.resource.data.status != 'finished')
        && (!('winnerId' in request.resource.data) || request.resource.data.winnerId == null);
      // hostId bất biến sau khi tạo; guestId không bao giờ được trùng hostId (chặn tự đấu
      // với chính mình); winnerId khi báo thắng chỉ được là chính hostId/guestId của room đó
      // (chặn gán thắng khống cho 1 uid bất kỳ) — applyMatchResult (functions/index.js) chỉ
      // cộng điểm dựa trên các field này nên phải khoá chặt ở đây.
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.guestId == request.auth.uid ||
        !resource.data.keys().hasAny(['guestId']) ||
        request.resource.data.guestId == request.auth.uid
      )
        && request.resource.data.hostId == resource.data.hostId
        && (!('guestId' in request.resource.data)
            || request.resource.data.guestId == null
            || request.resource.data.guestId != request.resource.data.hostId)
        && (!('winnerId' in request.resource.data)
            || request.resource.data.winnerId == null
            || request.resource.data.winnerId == request.resource.data.hostId
            || request.resource.data.winnerId == request.resource.data.guestId);
      // Chủ phòng luôn được tự xoá phòng của mình. Ngoài ra, BẤT KỲ ai đã đăng nhập cũng
      // được xoá một phòng nếu "nhịp tim" (lastSeen) của chủ phòng đã im quá 15 giây — đây
      // là cơ chế dọn phòng "chết" (chủ phòng mất mạng/tắt app/crash) khi Firestore không có
      // onDisconnect() như Realtime Database. Ngưỡng 15s > ROOM_LIVE_STALE_MS (12s) phía
      // client để client luôn là người phát hiện + xoá trước trong điều kiện bình thường.
      allow delete: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        (resource.data.lastSeen is timestamp &&
         request.time > resource.data.lastSeen + duration.value(15, 's'))
      );

      match /moves/{moveId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }

      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && chatPayloadOk();
      }
    }

    /* Báo cáo người dùng / nội dung vi phạm — client chỉ được tạo, không đọc/sửa/xoá */
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    /* Chat thế giới */
    match /worldChat/{channelId} {
      allow read: if signedIn();
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && chatPayloadOk();
      }
    }

    /* Chat bạn bè (DM) — dmId = uidA_uidB (sorted) */
    match /dms/{dmId} {
      allow read: if signedIn() && (
        !exists(/databases/$(database)/documents/dms/$(dmId)) ||
        request.auth.uid in resource.data.members
      );
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
        allow create: if signedIn()
          && chatPayloadOk()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
      }
    }
  }
}
