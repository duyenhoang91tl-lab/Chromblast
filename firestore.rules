rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function chatPayloadOk() {
      return request.resource.data.keys().hasAll(['uid','name','text','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 120;
    }
    function scoreField(field) {
      return !(field in request.resource.data)
        || (resource == null && request.resource.data[field] == 0)
        || (resource != null && !(field in resource.data) && request.resource.data[field] == 0)
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }
    function scoreFieldsUnchanged() {
      return scoreField('caroWins') && scoreField('caroLosses') && scoreField('caroDraws')
        && scoreField('caroPoints') && scoreField('pvpPoints') && scoreField('wins')
        && scoreField('losses') && scoreField('draws')
        && scoreField('pvpWins') && scoreField('pvpLosses') && scoreField('pvpDraws')
        && scoreField('bestPvpScore') && scoreField('bestScore');
    }
    /* Giống scoreField() nhưng cho phép giá trị KHỞI TẠO khác 0 (vd: gold bắt đầu 20,
       hearts bắt đầu 5) — khớp START_GOLD/MAX_HEARTS trong js/inventory.js. Sau khi đã
       có field trên doc thì tuyệt đối chỉ Cloud Function (Admin SDK) mới đổi được. */
    function walletField(field, startValue) {
      return !(field in request.resource.data)
        || (resource == null && request.resource.data[field] == startValue)
        || (resource != null && !(field in resource.data) && request.resource.data[field] == startValue)
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }
    /* Field chỉ Cloud Function (Admin SDK) được ghi — client gửi lên field này coi như
       không đổi gì (bị bỏ qua ở tầng rule), dùng cho mốc thời gian chống báo điểm khống. */
    function fieldLocked(field) {
      return !(field in request.resource.data)
        || (resource != null && field in resource.data && request.resource.data[field] == resource.data[field]);
    }
    /* Vàng/kim cương/tim: trước đây 100% ở localStorage (inventory.js), ai mở Console
       gọi grantGold()/grantDiamonds() là có tiền vô hạn — từ khi có IAP (js/iap.js) lỗ
       này đụng thẳng tiền thật. Từ đây 3 field này + mốc hồi tim sống trên players/{uid},
       client chỉ được thấy giá trị KHỞI TẠO đúng 1 lần lúc tạo tài khoản, sau đó chỉ đọc —
       mọi thay đổi phải qua Cloud Function (spendCurrency/exchangeCurrency/regenHearts/
       claimDailyReward/claimQuestReward/claimPeriodReward/giftHeart/revenuecatWebhook). */
    function walletFieldsUnchanged() {
      return walletField('gold', 20) && walletField('diamonds', 0) && walletField('hearts', 5)
        && fieldLocked('heartsAt');
    }

    /* ── GUILD (Hội nhóm) — helpers dùng chung cho toàn bộ rule guild bên dưới ── */
    function guildMemberOf(guildId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guilds/$(guildId)/members/$(request.auth.uid));
    }
    function guildModeratorOf(guildId) {
      return guildMemberOf(guildId) && (
        get(/databases/$(database)/documents/guilds/$(guildId)).data.leaderUid == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.deputyUids
      );
    }
    /* Field cấu trúc nhóm chỉ Cloud Function (Admin SDK) được ghi — client gửi lên
       field này coi như không đổi gì. Chặn tự sửa level/capacity/leaderUid/deputyUids/
       memberCount/vaultGold/vaultDiamond/điểm tuần — mọi thay đổi phải qua Cloud
       Function transaction để tránh gian lận/race condition. */
    function guildSensitiveFieldsUnchanged() {
      return fieldLocked('level') && fieldLocked('capacity') && fieldLocked('leaderUid')
        && fieldLocked('deputyUids') && fieldLocked('memberCount')
        && fieldLocked('vaultGold') && fieldLocked('vaultDiamond')
        && fieldLocked('weeklyActivity') && fieldLocked('weeklyGold') && fieldLocked('weeklyDiamond')
        && fieldLocked('seasonId') && fieldLocked('createdAt');
    }
    /* Field vai trò/điểm/đóng góp của member chỉ Cloud Function quản lý — chặn
       client tự reset hạn mức ngày/tuần hay tự cộng điểm năng động của chính mình. */
    function guildMemberFieldsUnchanged() {
      return fieldLocked('role') && fieldLocked('joinedAt')
        && fieldLocked('weeklyActivity') && fieldLocked('weeklyGoldContributed')
        && fieldLocked('weeklyDiamondContributed') && fieldLocked('lastContributionDate')
        && fieldLocked('dailyGoldContributed') && fieldLocked('dailyDiamondContributed');
    }

    /* Chặn "báo thắng khống tức thời": trước đây bất kỳ host/guest nào cũng tự chuyển
       status phòng của mình sang 'finished' kèm winnerId/hostScore/guestScore tuỳ ý —
       applyMatchResult (Admin SDK) tin thẳng các field này nên chỉ chuyển việc CỘNG điểm
       sang server là chưa đủ, còn phải khoá luôn ĐẦU VÀO của nó ở đây:
       1) Phòng phải tồn tại tối thiểu 8 giây thực kể từ createdAt (mốc server thật, xem
          allow create: createdAt == request.time nên không giả được) mới được phép
          finished — chặn kiểu bot tạo+báo thắng liên tục trong khi không hề chơi.
       2) Với Đấu 1-1 (versus): hostScore/guestScore phải là số không âm và không vượt
          trần hợp lý — trần đặt rất rộng so với điểm thật tối đa 1 trận ~90 giây, chỉ để
          chặn báo số kiểu 999999.
       Không áp dụng cho các lần update khác (đồng bộ hostScore/guestScore giữa chừng
       trận, cập nhật lastSeen, ... vẫn diễn ra bình thường vì status vẫn khác 'finished'). */
    function roomFinishOk() {
      return resource.data.status == 'finished'
        || request.resource.data.status != 'finished'
        || (
          resource.data.createdAt is timestamp
          && request.time > resource.data.createdAt + duration.value(8, 's')
          && (
            request.resource.data.gameType != 'versus'
            || (
              request.resource.data.hostScore is number && request.resource.data.hostScore >= 0
              && request.resource.data.hostScore <= 5000
              && request.resource.data.guestScore is number && request.resource.data.guestScore >= 0
              && request.resource.data.guestScore <= 5000
            )
          )
        );
    }

    /* Tài khoản đăng nhập cục bộ (username/mật khẩu) — CHỈ Cloud Function (Admin SDK,
       bỏ qua rules) được đọc/ghi. Chứa hash mật khẩu + câu trả lời bảo mật, tuyệt đối
       không cho client đọc/ghi trực tiếp dù đã đăng nhập hay chưa.
       Xem functions/index.js: registerAccount/loginAccount/... */
    match /localAccounts/{doc} {
      allow read, write: if false;
    }

    /* Sổ dedupe webhook IAP (functions/index.js: revenuecatWebhook) — chỉ Admin SDK
       đụng vào, chặn client đọc/ghi để không dò được lịch sử giao dịch của người khác. */
    match /iapEvents/{eventId} {
      allow read, write: if false;
    }

    /* BXH kỳ (ngày/tuần/tháng) — client chỉ đọc, ghi qua Cloud Function */
    match /periodScores/{periodId} {
      allow read: if signedIn();
      match /entries/{uid} {
        allow read: if signedIn();
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }
    }

    /* ID công khai CBxxxxxx → uid (tìm bạn theo ID) */
    match /playerIds/{publicId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid']);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    /* Bộ đếm giới hạn thưởng referral/ngày cho 1 người mời — chỉ Cloud Function
       (Admin SDK) đọc/ghi, xem functions/index.js: submitSoloScore. */
    match /referralCaps/{doc} {
      allow read, write: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && scoreFieldsUnchanged() && fieldLocked('currentRunStartedAt')
        && fieldLocked('referredBy') && fieldLocked('referralRewardPending')
        && fieldLocked('referralRewardGold') && fieldLocked('referralRewardDiamond')
        && walletFieldsUnchanged();
      allow delete: if isOwner(uid);

      /* Sổ "đã nhận thưởng chưa" cho quest/BXH kỳ (1 doc = 1 lần nhận, tạo bằng
         transaction trong Cloud Function) — chỉ Admin SDK đụng vào, chặn client tự
         tạo/xoá để nhận lại nhiều lần. */
      match /claims/{claimId} {
        allow read, write: if false;
      }

      match /friends/{fid} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(uid);
      }

      /* Thông báo hệ thống (vd: "bị vượt hạng BXH ngày/tuần/tháng" — ghi bởi
         submitSoloScore, Admin SDK). Chủ tài khoản: đọc, tự xoá thông báo của mình,
         và chỉ được SỬA đúng field read (đánh dấu đã đọc) — không được tự chèn
         thông báo khống (create:false) hay sửa nội dung (byScore/byName/...). */
      match /notifications/{notifId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }

      match /lbClaims/{claimId} {
        allow read, create, update: if isOwner(uid);
      }

      /* Danh sách người dùng đã chặn — chỉ chủ tài khoản đọc/ghi được */
      match /blocked/{blockedUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasAll(['blockedAt']);
        allow delete: if isOwner(uid);
      }

      /* Lời mời kết bạn — người nhận sở hữu doc */
      match /friendRequests/{fromUid} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.status in ['pending', 'accepted_notice'];
      }

      /* Lời mời vào phòng — người nhận sở hữu doc */
      match /invites/{inviteId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.roomId is string
          && request.resource.data.code is string
          && request.resource.data.gameType in ['caro', 'versus'];
      }

    }

    match /matchQueue/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(uid);
    }

    /* Nhịp tim "còn sống" của chủ phòng — TÁCH RIÊNG khỏi rooms/{roomId} có chủ đích.
       Trước đây lastSeen nằm ngay trong document rooms/{roomId}: mỗi lần chủ phòng ghi
       nhịp tim (8s/lần) khiến document đó "đổi" trong mắt Firestore, nên MỌI client đang
       đứng ở sảnh chờ (onSnapshot danh sách phòng mở) đều bị tính 1 lượt đọc lại dù chẳng
       có gì đáng xem thay đổi cả — chi phí đọc nhân theo (số người ở sảnh) × (số phòng đang
       mở). Đưa nhịp tim ra đây để nó không còn "đánh thức" listener danh sách phòng mở nữa;
       phía client giờ tự dò theo lô (xem listenOpenRoomsByGameType trong online-services.js)
       thay vì nhận lastSeen kèm theo mỗi snapshot. */
    match /roomPresence/{roomId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.hostId;
      allow delete: if signedIn();
    }

    /* Đấu clan (Task 3): 1 phòng /rooms được TẠO SẴN với battleId/hostClanId/guestClanId
       (qua createClanBattleRoom, js/online-services.js) chỉ hợp lệ nếu khớp ĐÚNG 1
       clanBattles/{battleId} đang 'matched', roomId của battle đó còn null (chưa ai tạo
       phòng cho battle này), người tạo phòng đúng là hostUid của battle, và vẫn còn là
       leader/deputy của hostClanId lúc này (guildModeratorOf) — không có battleId thì
       coi như phòng casual bình thường, bỏ qua hết điều kiện này (giữ nguyên hành vi cũ). */
    function roomClanTagOk() {
      return !('battleId' in request.resource.data) || request.resource.data.battleId == null || (
        request.resource.data.hostClanId is string
        && request.resource.data.guestClanId is string
        && get(/databases/$(database)/documents/clanBattles/$(request.resource.data.battleId)).data.status == 'matched'
        && get(/databases/$(database)/documents/clanBattles/$(request.resource.data.battleId)).data.roomId == null
        && get(/databases/$(database)/documents/clanBattles/$(request.resource.data.battleId)).data.hostUid == request.auth.uid
        && get(/databases/$(database)/documents/clanBattles/$(request.resource.data.battleId)).data.hostClanId == request.resource.data.hostClanId
        && get(/databases/$(database)/documents/clanBattles/$(request.resource.data.battleId)).data.guestClanId == request.resource.data.guestClanId
        && guildModeratorOf(request.resource.data.hostClanId)
      );
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      // Người tạo phải là host hoặc guest của chính room đó (chặn ghép mạo danh),
      // guestId không được trùng hostId (chặn tự đấu với chính mình để x2 điểm),
      // và không được tạo phòng đã ở trạng thái 'finished' sẵn hoặc có winnerId
      // (chặn bỏ qua trận đấu, tạo thẳng phòng "đã thắng" để applyMatchResult cộng điểm khống).
      allow create: if signedIn()
        && request.resource.data.hostId is string
        && (
          request.auth.uid == request.resource.data.hostId ||
          (('guestId' in request.resource.data) && request.auth.uid == request.resource.data.guestId)
        )
        && (!('guestId' in request.resource.data)
            || request.resource.data.guestId == null
            || request.resource.data.guestId != request.resource.data.hostId)
        && (!('status' in request.resource.data) || request.resource.data.status != 'finished')
        && (!('winnerId' in request.resource.data) || request.resource.data.winnerId == null)
        // Cược vàng/kim cương (tuỳ chọn, đặt lúc tạo phòng): không cược thì bỏ qua các field
        // này hoặc để 0; có cược thì phải là số dương hợp lý + đúng loại tiền tệ. Cờ escrow/
        // settled TUYỆT ĐỐI không được tự nhận đã escrow/settled ngay lúc tạo phòng — chỉ
        // Cloud Function (escrowWager/applyMatchResult, Admin SDK) mới ghi được các cờ này,
        // xem fieldLocked() ở allow update bên dưới.
        && (
          !('wagerAmount' in request.resource.data)
          || request.resource.data.wagerAmount == 0
          || (
            request.resource.data.wagerAmount is number
            && request.resource.data.wagerAmount > 0
            && request.resource.data.wagerAmount <= 10000
            && ('wagerCurrency' in request.resource.data)
            && request.resource.data.wagerCurrency in ['gold', 'diamond']
          )
        )
        && (!('hostEscrowed' in request.resource.data) || request.resource.data.hostEscrowed == false)
        && (!('guestEscrowed' in request.resource.data) || request.resource.data.guestEscrowed == false)
        && (!('wagerSettled' in request.resource.data) || request.resource.data.wagerSettled == false)
        // createdAt phải là mốc server thật (không tự đặt lùi về quá khứ được) — đây là
        // "đồng hồ" mà roomFinishOk() dựa vào để chặn báo thắng khống tức thời.
        && request.resource.data.createdAt == request.time
        && roomClanTagOk();
      // hostId bất biến sau khi tạo — NGOẠI LỆ DUY NHẤT: chính chủ phòng hiện tại tự
      // chuyển quyền chủ phòng sang đúng khách đang có trong phòng trước khi rời (xem
      // leaveOnlineRoom, js/online-services.js) — không ai khác được kích hoạt nhánh
      // này, và hostId mới chỉ được set đúng bằng guestId hiện tại (không gán tuỳ ý cho
      // uid khác). guestId không bao giờ được trùng hostId (chặn tự đấu với chính mình);
      // winnerId khi báo thắng chỉ được là chính hostId/guestId của room đó (chặn gán
      // thắng khống cho 1 uid bất kỳ) — applyMatchResult (functions/index.js) chỉ cộng
      // điểm dựa trên các field này nên phải khoá chặt ở đây.
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        resource.data.guestId == request.auth.uid ||
        !resource.data.keys().hasAny(['guestId']) ||
        request.resource.data.guestId == request.auth.uid
      )
        && (
          request.resource.data.hostId == resource.data.hostId
          || (
            resource.data.hostId == request.auth.uid
            && resource.data.guestId is string
            && request.resource.data.hostId == resource.data.guestId
          )
        )
        && (!('guestId' in request.resource.data)
            || request.resource.data.guestId == null
            || request.resource.data.guestId != request.resource.data.hostId)
        && (!('winnerId' in request.resource.data)
            || request.resource.data.winnerId == null
            || request.resource.data.winnerId == request.resource.data.hostId
            || request.resource.data.winnerId == request.resource.data.guestId)
        // Cược: số tiền/loại tiền bất biến sau khi tạo phòng (không cho đổi mức cược giữa
        // chừng sau khi đối thủ đã vào — chặn kiểu nâng/hạ cược lừa đối thủ). Cờ escrow/
        // settled chỉ Cloud Function ghi được (escrowWager/applyMatchResult) — client update
        // KHÔNG được tự set các cờ này dù đúng hay sai giá trị.
        && fieldLocked('wagerAmount') && fieldLocked('wagerCurrency')
        && fieldLocked('hostEscrowed') && fieldLocked('guestEscrowed') && fieldLocked('wagerSettled')
        // Tag đấu clan (Task 3) — bất biến sau khi tạo, không ai (kể cả host/guest) tự gắn/
        // đổi/gỡ sau đó qua SDK — chặn kiểu tự gắn battleId của trận người khác vào phòng
        // mình để "ăn ké" điểm năng động clan khi Cloud Function tính kết quả (Task 9).
        && fieldLocked('battleId') && fieldLocked('hostClanId') && fieldLocked('guestClanId')
        && roomFinishOk();
      // Chủ phòng luôn được tự xoá phòng của mình. Ngoài ra, BẤT KỲ ai đã đăng nhập cũng
      // được xoá một phòng nếu "nhịp tim" (lastSeen, nay ở collection roomPresence riêng —
      // xem match /roomPresence ở trên) của chủ phòng đã im quá 30 giây — đây là cơ chế dọn
      // phòng "chết" (chủ phòng mất mạng/tắt app/crash) khi Firestore không có onDisconnect()
      // như Realtime Database. Ngưỡng 30s > ROOM_LIVE_STALE_MS (24s) phía client để client
      // luôn là người phát hiện + xoá trước trong điều kiện bình thường.
      allow delete: if signedIn() && (
        resource.data.hostId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/roomPresence/$(roomId)) &&
          get(/databases/$(database)/documents/roomPresence/$(roomId)).data.lastSeen is timestamp &&
          request.time > get(/databases/$(database)/documents/roomPresence/$(roomId)).data.lastSeen + duration.value(30, 's')
        )
      );

      // Chỉ host/guest của CHÍNH room đó được gửi nước đi / chat trong trận — trước đây
      // "if signedIn()" cho phép BẤT KỲ ai đã đăng nhập ghi vào nước đi/chat của người
      // khác (chèn nước đi giả vào trận người lạ, spam chat phòng người khác).
      match /moves/{moveId} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.guestId == request.auth.uid
        );
      }

      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && chatPayloadOk() && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.guestId == request.auth.uid
        );
      }
    }

    /* ══════════════ ĐẤU CLAN (clanBattles) — SPEC "Muông Thú Đại Chiến" Phase 1/Task 1 ══════════════
       Phòng thách đấu clan (mã 6 ký tự), TÁCH RIÊNG khỏi /rooms (rooms là ván Caro/Versus
       thật, gắn battleId vào ở Task 3). Ở Task 1 này, client chỉ:
         - Đọc mọi phòng đã đăng nhập (để duyệt/vào bằng mã — Task 2).
         - TẠO phòng nếu chính là hostUid VÀ đang thực sự là leader/deputy của ĐÚNG
           clan mình khai (chặn giả mạo đại diện clan khác) — playerGuilds/{uid}.guildId
           phải khớp hostClanId khai trong doc.
         - XOÁ phòng của chính mình (huỷ chờ) khi vẫn còn "open" (chưa ai ghép).
       Việc GHÉP đối thủ (update guestXxx/status→'matched') để Task 2 mở thêm, và việc
       CHUYỂN status→'finished'/winnerClanId CHỈ Cloud Function (Admin SDK, Task 9) được
       ghi — client tuyệt đối không tự update các field đó qua SDK. */
    function cbIsMyGuild(guildId) {
      return signedIn()
        && exists(/databases/$(database)/documents/playerGuilds/$(request.auth.uid))
        && get(/databases/$(database)/documents/playerGuilds/$(request.auth.uid)).data.guildId == guildId;
    }
    /* Task 2: ghép đối thủ — CHỈ 1 chuyển tiếp hợp lệ duy nhất 'open' → 'matched',
       do CHÍNH leader/deputy của 1 clan KHÁC hostClanId thực hiện, tự nhận đúng UID/
       clan của mình (không gán hộ clan/uid khác); mọi field của HOST (kể cả code/
       mode/createdAt) và winnerClanId/roomId (dành cho Task 3/9) bất biến ở bước này.
       Vì điều kiện đòi resource.data.status=='open', bất kỳ ai thử update lần 2 sau
       khi đã 'matched' đều bị chặn — không cần thêm nhánh nào khác ở Task 2. */
    function cbJoinOk() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'matched'
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.guestClanId is string
        && request.resource.data.guestClanId != resource.data.hostClanId
        && cbIsMyGuild(request.resource.data.guestClanId)
        && guildModeratorOf(request.resource.data.guestClanId)
        && request.resource.data.guestRole in ['leader', 'deputy']
        && fieldLocked('hostUid') && fieldLocked('hostClanId') && fieldLocked('hostClanName')
        && fieldLocked('hostName') && fieldLocked('hostAvatar') && fieldLocked('hostRole')
        && fieldLocked('code') && fieldLocked('mode') && fieldLocked('createdAt')
        && fieldLocked('winnerClanId') && fieldLocked('roomId');
    }
    /* Task 3: SAU KHI đã ghép ('matched'), CHÍNH host (đúng hostUid) gắn roomId của
       phòng Caro/Versus THẬT (đã tạo qua createClanBattleRoom, js/online-services.js)
       vào lại đây — để guest (và cả 2 bên nếu tự mở lại tab) biết phòng nào mà vào.
       Chỉ được set 1 LẦN (resource.data.roomId phải đang null), và room đó phải THẬT
       SỰ do chính mình host + đã gắn đúng battleId/hostClanId/guestClanId của CHÍNH
       battle này (không được trỏ láo sang phòng người khác/phòng không gắn tag) —
       roomClanTagOk() ở match /rooms/{roomId} bên dưới đã xác thực chiều ngược lại
       (phòng phải khớp battle) lúc TẠO phòng, ở đây xác thực thêm chiều này (battle
       chỉ được nhận đúng roomId của phòng đã khớp mình) để chặn 2 phía đều phải khớp. */
    function cbSetRoomIdOk() {
      return resource.data.status == 'matched'
        && resource.data.hostUid == request.auth.uid
        && resource.data.roomId == null
        && request.resource.data.roomId is string
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.battleId == battleId
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.gameType == resource.data.mode
        && fieldLocked('hostUid') && fieldLocked('hostClanId') && fieldLocked('hostClanName')
        && fieldLocked('hostName') && fieldLocked('hostAvatar') && fieldLocked('hostRole')
        && fieldLocked('guestUid') && fieldLocked('guestClanId') && fieldLocked('guestClanName')
        && fieldLocked('guestName') && fieldLocked('guestAvatar') && fieldLocked('guestRole')
        && fieldLocked('code') && fieldLocked('mode') && fieldLocked('createdAt')
        && fieldLocked('status') && fieldLocked('winnerClanId');
    }
    match /clanBattles/{battleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostClanId is string
        && cbIsMyGuild(request.resource.data.hostClanId)
        && guildModeratorOf(request.resource.data.hostClanId)
        && request.resource.data.mode in ['caro', 'versus']
        && request.resource.data.status == 'open'
        && (!('guestUid' in request.resource.data) || request.resource.data.guestUid == null)
        && (!('winnerClanId' in request.resource.data) || request.resource.data.winnerClanId == null)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (cbJoinOk() || cbSetRoomIdOk());
      // Chủ phòng tự huỷ phòng CHỜ của mình (chưa ai ghép) bất cứ lúc nào.
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status == 'open';
    }

    /* Báo cáo người dùng / nội dung vi phạm — client chỉ được tạo, không đọc/sửa/xoá */
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    /* Chat thế giới */
    match /worldChat/{channelId} {
      allow read: if signedIn();
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && chatPayloadOk();
      }
    }

    /* Chat bạn bè (DM) — dmId = uidA_uidB (sorted) */
    match /dms/{dmId} {
      allow read: if signedIn() && (
        !exists(/databases/$(database)/documents/dms/$(dmId)) ||
        request.auth.uid in resource.data.members
      );
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
        allow create: if signedIn()
          && chatPayloadOk()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
      }
    }

    /* ══════════════ GUILD (HỘI NHÓM) ══════════════
       Tạo/join/leave/đóng góp/nâng cấp/nhiệm vụ/reset tuần đều qua Cloud Function
       (functions/index.js: createGuild/joinGuild/leaveGuild/contributeToGuild/
       upgradeGuild/completeGuildQuest/weeklyGuildReset) — Admin SDK bỏ qua rules.
       Client chỉ được:
         - ĐỌC guild + subcollection (members/quests) nếu LÀ THÀNH VIÊN của guild đó.
         - Leader/Phó cập nhật tên/icon của guild (field nhạy cảm level/capacity/
           leaderUid/deputyUids/memberCount/vault... vẫn bị khoá — chỉ Cloud
           Function đổi, KHÔNG update thẳng qua SDK).
         - Tự đổi displayName của CHÍNH mình trong members/{uid}.
       KHÔNG cho client tự sửa vaultGold/vaultDiamond hay field đóng góp trực tiếp
       qua SDK (phải qua Cloud Function transaction để tránh gian lận/race). */
    match /guilds/{guildId} {
      allow read: if guildMemberOf(guildId);
      // Tạo nhóm qua createGuild (Cloud Function) — client không tự tạo doc trực tiếp.
      allow create: if false;
      allow update: if guildModeratorOf(guildId)
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() >= 2
                && request.resource.data.name.size() <= 24))
        && (!('iconId' in request.resource.data) || request.resource.data.iconId is string)
        && request.resource.data.updatedAt == request.time
        && guildSensitiveFieldsUnchanged();
      allow delete: if false;

      match /members/{uid} {
        allow read: if guildMemberOf(guildId);
        // Tham gia qua joinGuild (Cloud Function) — client không tự tạo hồ sơ.
        allow create: if false;
        // Thành viên chỉ được sửa doc CỦA CHÍNH MÌNH, và chỉ đổi displayName —
        // mọi field vai trò/điểm/đóng góp do Cloud Function quản lý (không tự
        // ghi hộ người khác, không tự reset hạn mức/điểm của mình).
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 24
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && guildMemberFieldsUnchanged();
        allow delete: if false;
      }

      match /quests/{questId} {
        allow read: if guildMemberOf(guildId);
        // Nhiệm vụ nhóm do completeGuildQuest / weeklyGuildReset (Cloud Function)
        // tạo & cập nhật — client chỉ đọc.
        allow write: if false;
      }
    }

    /* Chỉ mục CÔNG KHAI để người chưa có nhóm duyệt danh sách guild còn slot
       (Tìm & tham gia nhóm) — chỉ chứa field hiển thị tối thiểu, Cloud Function
       đồng bộ khi tạo/join/leave/nâng cấp. Không lộ field nội bộ nhóm. */
    match /guildIndex/{guildId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* Bản đồ uid → guildId của chính người chơi (tra cứu nhóm mình đang ở) —
       chủ tài khoản đọc, chỉ Cloud Function ghi. */
    match /playerGuilds/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    /* BXH tuần của guild (snapshot cuối tuần) — công khai cho ai đã đăng nhập
       đọc lịch sử, chỉ Cloud Function weeklyGuildReset ghi. */
    match /guildRankings/{weekId} {
      allow read: if signedIn();
      match /entries/{guildId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
